generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id          BigInt  @id @default(autoincrement())
  name        String  @db.VarChar(150)
  domain      String  @unique @db.VarChar(255)
  description String? @db.Text

  status     String  @default("active") @db.VarChar(30)
  isActive   Boolean @default(true) @map("is_active")
  isPlatform Boolean @default(false) @map("is_platform")

  settings Json? @db.Json
  metadata Json? @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  users           User[]
  departments     Department[]
  roles           Role[]
  permissions     Permission[]
  userRoles       UserRole[]
  userDepartments UserDepartment[]
  rolePermissions RolePermission[]
  tenantModules   TenantModule[]

  @@index([status])
  @@index([isPlatform])
  @@map("tenants")
}

model User {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  name         String  @db.VarChar(150)
  email        String  @db.VarChar(255)
  passwordHash String? @map("password_hash") @db.VarChar(255)

  avatarUrl    String? @map("avatar_url") @db.VarChar(500)

  status          String    @default("active") @db.VarChar(30)
  isActive        Boolean   @default(true) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamp(6)
  lastLoginIp String?   @map("last_login_ip") @db.VarChar(45)

  metadata Json? @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  userRoles       UserRole[]
  userDepartments UserDepartment[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([status])
  @@map("users")
}

model Department {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  name        String  @db.VarChar(150)
  description String? @db.Text

  status   String  @default("active") @db.VarChar(30)
  isActive Boolean @default(true) @map("is_active")

  sortOrder Int @default(0) @map("sort_order")

  metadata Json? @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  userDepartments UserDepartment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

model Role {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  name        String  @db.VarChar(100)
  description String? @db.Text

  isSystem  Boolean @default(false) @map("is_system")
  isActive  Boolean @default(true) @map("is_active")

  metadata Json? @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
  @@map("roles")
}

model Module {
  id BigInt @id @default(autoincrement())

  name        String  @db.VarChar(100)
  description String? @db.Text

  icon      String? @db.VarChar(100)
  route     String? @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")

  isSystem       Boolean @default(false) @map("is_system")
  isActive       Boolean @default(true) @map("is_active")

  metadata Json? @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  permissions   Permission[]
  tenantModules TenantModule[]

  @@index([isActive])
  @@map("modules")
}

model Action {
  id BigInt @id @default(autoincrement())

  name        String  @db.VarChar(100)
  description String? @db.Text

  sortOrder Int @default(0) @map("sort_order")

  isActive Boolean @default(true) @map("is_active")

  metadata Json? @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  permissions Permission[]

  @@index([isActive])
  @@map("actions")
}

model Permission {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")

  moduleId BigInt @map("module_id")
  actionId BigInt @map("action_id")

  name        String  @db.VarChar(150)
  description String? @db.Text

  isActive Boolean @default(true) @map("is_active")

  metadata Json? @db.Json

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])
  action Action @relation(fields: [actionId], references: [id])

  rolePermissions RolePermission[]

  @@unique([tenantId, moduleId, actionId])
  @@index([tenantId])
  @@index([moduleId])
  @@index([actionId])
  @@index([isActive])
  @@map("permissions")
}

model UserRole {
  tenantId BigInt @map("tenant_id")
  userId   BigInt @map("user_id")
  roleId   BigInt @map("role_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy BigInt?  @map("created_by")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([tenantId, userId, roleId])
  @@index([tenantId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model UserDepartment {
  tenantId     BigInt @map("tenant_id")
  userId       BigInt @map("user_id")
  departmentId BigInt @map("department_id")

  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy BigInt?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@id([tenantId, userId, departmentId])
  @@index([tenantId])
  @@index([userId])
  @@index([departmentId])
  @@map("user_departments")
}

model RolePermission {
  tenantId     BigInt @map("tenant_id")
  roleId       BigInt @map("role_id")
  permissionId BigInt @map("permission_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy BigInt?  @map("created_by")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([tenantId, roleId, permissionId])
  @@index([tenantId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model TenantModule {
  tenantId BigInt @map("tenant_id")
  moduleId BigInt @map("module_id")

  isEnabled  Boolean   @default(true) @map("is_enabled")
  enabledAt  DateTime  @default(now()) @map("enabled_at") @db.Timestamp(6)
  disabledAt DateTime? @map("disabled_at") @db.Timestamp(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy BigInt?  @map("created_by")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@id([tenantId, moduleId])
  @@index([tenantId])
  @@index([moduleId])
  @@map("tenant_modules")
}

model AuditLog {
  id BigInt @id @default(autoincrement())

  actorUserId BigInt @map("actor_user_id")

  action     String  @db.VarChar(100)
  targetType String  @map("target_type") @db.VarChar(50)
  targetId   BigInt? @map("target_id")
  tenantId   BigInt? @map("tenant_id")

  metadata Json? @db.Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([actorUserId])
  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
